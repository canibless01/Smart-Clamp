# Server-only. Fill through deployment settings; never commit real credentials.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Generate once with cryptography.fernet.Fernet.generate_key(); preserve across deployments.
# Encrypts distinct per-device telemetry and command secrets, never derived from a shared master.
DEVICE_HMAC_ENCRYPTION_KEY=
PAYSTACK_SECRET_KEY=
# Current Paystack-Signature signing secret (whsec_...). Configure before migrating
# webhook signing mode. A configured secret requires timestamped modern signatures.
PAYSTACK_WEBHOOK_SECRET=
# Rotation overlap only; remove the previous secret after provider overlap expires.
PAYSTACK_WEBHOOK_PREVIOUS_SECRET=
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
# Prefer the allowlisted JSON catalogue for multiple providers, e.g. [{"id":"provider-service-id","name":"Approved provider name"}]
VTPASS_ELECTRICITY_SERVICES_JSON=
# Alternatively configure one provider, using its confirmed VTPass service ID.
VTPASS_ELECTRICITY_SERVICE_ID=
VTPASS_ELECTRICITY_SERVICE_NAME=
# Explicit approved fee policy; integer basis points / kobo. Zero must be entered explicitly if intended.
PAYMENT_FEE_BPS=
PAYMENT_FIXED_FEE_KOBO=
PLATFORM_MARKUP_BPS=
# Exact public HTTPS frontend origin; used for hosted checkout callbacks.
APP_ORIGIN=
CORS_ORIGINS=
# Optional opt-in SMS. Requires an approved Africa's Talking sender/account and user consent.
# Exact lowercase true enables dispatch; false/default leaves only durable in-app records.
SMS_ENABLED=false
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Sandbox: https://api.sandbox.africastalking.com/version1/messaging (sandbox account only).
AT_SMS_URL=https://api.africastalking.com/version1/messaging
# Firmware signing private key stays server-only. RSA >=3072 bits; provision its public
# key/fingerprint into qualified devices. Disable dispatch until partitions/rollback pass.
OTA_ENABLED=false
OTA_SIGNING_KEY_FILE=
# Separate private RSA >=3072-bit signing key for immutable measurement reports.
REPORT_SIGNING_KEY_FILE=
