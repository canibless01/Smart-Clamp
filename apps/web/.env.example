# Copy to apps/web/.env.local — Next.js public env (NEXT_PUBLIC_ prefix required for browser)
NEXT_PUBLIC_API_BASE=http://localhost:5000/api/v1
# For same-origin proxy in production, leave NEXT_PUBLIC_API_BASE as /api/v1 and set API_PROXY_TARGET
API_PROXY_TARGET=http://localhost:5000

NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: analytics, error tracking
# NEXT_PUBLIC_SENTRY_DSN=
