# Server-only. Fill through deployment settings; never commit real credentials.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Generate once with cryptography.fernet.Fernet.generate_key(); preserve across deployments.
# Encrypts distinct per-device telemetry and command secrets, never derived from a shared master.
DEVICE_HMAC_ENCRYPTION_KEY=
PAYSTACK_SECRET_KEY=
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
# Prefer the allowlisted JSON catalogue for multiple providers, e.g. [{"id":"provider-service-id","name":"Approved provider name"}]
VTPASS_ELECTRICITY_SERVICES_JSON=
# Alternatively configure one provider, using its confirmed VTPass service ID.
VTPASS_ELECTRICITY_SERVICE_ID=
VTPASS_ELECTRICITY_SERVICE_NAME=
# Explicit approved fee policy; integer basis points / kobo. Zero must be entered explicitly if intended.
PAYMENT_FEE_BPS=
PAYMENT_FIXED_FEE_KOBO=
PLATFORM_MARKUP_BPS=
# Exact public HTTPS frontend origin; used for hosted checkout callbacks.
APP_ORIGIN=
# Versions must identify the exact owner-approved Terms/Privacy published with this release.
# Unset defaults are explicitly preview-only; check_config rejects preview versions for launch.
LEGAL_TERMS_VERSION=
LEGAL_PRIVACY_VERSION=
# Opt-in browser Web Push. Private VAPID P-256 key is a read-only secret mount.
WEB_PUSH_ENABLED=false
VAPID_PRIVATE_KEY_FILE=
# Actual operator contact, e.g. mailto:<monitored-address> or HTTPS contact URL.
VAPID_SUBJECT=
PUSH_ENCRYPTION_KEY=
CORS_ORIGINS=

# Web server/build settings. Vercel root directory: apps/web.
NEXT_PUBLIC_API_BASE=/api/v1
API_PROXY_TARGET=
SITE_URL=

# Optional transactional account email, separate from Supabase identity SMTP.
EMAIL_ENABLED=false
RESEND_API_KEY=
# One verified Resend sender, e.g. SmartClamp <notices@your-approved-domain>.
EMAIL_FROM=
# Distinct Fernet key; preserve so frozen email requests remain decryptable.
EMAIL_ENCRYPTION_KEY=

# Resend-first routing; counters reserve sends on UTC calendar days/months.
RESEND_DAILY_EMAIL_LIMIT=100
RESEND_MONTHLY_EMAIL_LIMIT=3000
ONESIGNAL_EMAIL_ENABLED=false
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
